{
  "name": "vivvy",
  "version": "0.1.0-alpha.1",
  "description": "Local, durable, single-machine vector engine and long-term agent memory for TypeScript and Node.js",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "gcc -O3 -shared -fPIC -I/usr/include/node -I../go/include binding/vivvy_napi.c ../target/release/libvivvy_ffi.a -lpthread -ldl -lm -o vivvy.node",
    "test": "node --test tests/*.test.ts"
  },
  "keywords": [
    "agent-memory",
    "vector-search",
    "hnsw",
    "sqlite",
    "llm",
    "rag",
    "ai-agents"
  ],
  "author": "one2seven-oss",
  "license": "BUSL-1.1"
}
